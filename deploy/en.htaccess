# Конфигурация для папки /en/: кладётся в сборку как dist/en/.htaccess.
#
# Нужна ради одной строки. Apache ищет ErrorDocument в ближайшем .htaccess,
# поэтому без этого файла на ошибочный адрес внутри английской версии
# открывалась бы русская страница 404 из корня сайта.

ErrorDocument 404 /en/404.html

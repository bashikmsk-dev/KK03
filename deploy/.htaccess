# Конфигурация для Apache и LiteSpeed — на них работает большинство
# российских виртуальных хостингов (Beget, Timeweb, reg.ru и подобные).
#
# Файл кладётся рядом с index.html, в корень сайта: то есть вместе с
# содержимым dist/. Переименовывать не нужно, имя .htaccess обязательно.

# Главная страница каталога — только index.html. На виртуальных хостингах
# Apache по умолчанию предпочитает index.php, и случайно оставшаяся заглушка
# хостинга показывалась бы вместо сайта.
DirectoryIndex index.html

# Своя страница 404 на любой несуществующий адрес
ErrorDocument 404 /404.html

# Архивы и прочие файлы, не относящиеся к сайту, наружу не отдаём
<FilesMatch "\.(zip|tar|gz|bak|log)$">
  Require all denied
</FilesMatch>

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"

  # Картинки, шрифты и стили собираются с хешем в имени: при изменении
  # меняется адрес, поэтому их можно кэшировать на год.
  <FilesMatch "\.(css|woff2|webp|avif|jpe?g|png|svg|ico)$">
    Header always set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>

  # Скрипты и страницы — без хеша в имени, браузер обязан их проверять,
  # иначе после правки посетитель останется со старой версией.
  <FilesMatch "\.(js|html|xml|txt)$">
    Header always set Cache-Control "public, max-age=0, must-revalidate"
  </FilesMatch>

  # Иконки сайта — исключение: лежат в корне под постоянными именами, которые
  # браузеры и поисковики запрашивают сами. Год здесь был бы ловушкой: сменив
  # иконку, мы не смогли бы показать новую тем, кто уже заходил. Сутки — и
  # лишних запросов нет, и обновление доходит.
  <FilesMatch "^(favicon\.ico|icon-192\.png|apple-touch-icon\.png)$">
    Header always set Cache-Control "public, max-age=86400"
  </FilesMatch>
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain application/javascript application/json image/svg+xml application/xml
</IfModule>

# Кириллица в текстовых файлах
AddDefaultCharset UTF-8

# Один адрес у сайта. Домены .com и www ведут в ту же папку (алиасами на
# хостинге), поэтому сводим их к основному адресу перенаправлением — иначе
# один и тот же сайт открывался бы по нескольким адресам и поисковики
# выбирали бы между ними сами.
#
# Технический адрес хостинга из правила исключён: он нужен, чтобы проверять
# сайт до переключения домена.
<IfModule mod_rewrite.c>
  RewriteEngine On

  RewriteCond %{HTTP_HOST} \.xsph\.ru$ [NC]
  RewriteRule ^ - [L]

  RewriteCond %{HTTP_HOST} !^cyber-kino-festival\.ru$ [NC]
  RewriteRule ^(.*)$ https://cyber-kino-festival.ru/$1 [R=301,L]
</IfModule>

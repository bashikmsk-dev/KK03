# Пример конфигурации nginx для сайта «Кибер Кино».
#
# Сайт — статика: отдаём содержимое dist/ и ничего не проксируем.
# Подставьте свой путь в root и имя домена в server_name.
#
# Важно про add_header: в nginx директивы add_header из внешнего блока
# НЕ наследуются там, где есть свои. Поэтому общие заголовки повторены
# в каждом location — это не копипаста по невнимательности.

server {
    listen 80;
    listen [::]:80;
    server_name cyber-kino-festival.ru www.cyber-kino-festival.ru;
    return 301 https://cyber-kino-festival.ru$request_uri;
}

# www → основной домен, чтобы у страниц был один адрес
server {
    listen 443 ssl;
    http2 on;
    server_name www.cyber-kino-festival.ru;

    ssl_certificate     /etc/letsencrypt/live/cyber-kino-festival.ru/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/cyber-kino-festival.ru/privkey.pem;

    return 301 https://cyber-kino-festival.ru$request_uri;
}

server {
    listen 443 ssl;
    http2 on;
    server_name cyber-kino-festival.ru;

    ssl_certificate     /etc/letsencrypt/live/cyber-kino-festival.ru/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/cyber-kino-festival.ru/privkey.pem;

    # сюда выкладывается содержимое dist/
    root /var/www/cyber-kino;
    index index.html;
    charset utf-8;

    # своя страница 404 — на любой несуществующий адрес, включая вложенные
    error_page 404 /404.html;

    gzip on;
    gzip_comp_level 6;
    gzip_min_length 1024;
    gzip_types text/plain text/css application/javascript application/json image/svg+xml application/xml;

    # Картинки, шрифты и стили собираются с хешем в имени: при изменении
    # меняется адрес, поэтому их можно кэшировать на год.
    location ~* \.(?:css|woff2|webp|avif|jpe?g|png|svg|ico)$ {
        add_header Cache-Control "public, max-age=31536000, immutable" always;
        add_header X-Content-Type-Options "nosniff" always;
        add_header Referrer-Policy "strict-origin-when-cross-origin" always;
        try_files $uri =404;
    }

    # Скрипты копируются в сборку без хеша — браузер обязан их проверять,
    # иначе после правки посетитель останется со старой версией.
    location ~* \.js$ {
        add_header Cache-Control "public, max-age=0, must-revalidate" always;
        add_header X-Content-Type-Options "nosniff" always;
        add_header Referrer-Policy "strict-origin-when-cross-origin" always;
        try_files $uri =404;
    }

    # Внутри английской версии — своя страница 404, иначе на ошибочный
    # адрес вида /en/опечатка открывалась бы русская.
    location ^~ /en/ {
        add_header Cache-Control "public, max-age=0, must-revalidate" always;
        add_header X-Content-Type-Options "nosniff" always;
        add_header Referrer-Policy "strict-origin-when-cross-origin" always;
        error_page 404 /en/404.html;
        try_files $uri $uri/ =404;
    }

    # .htaccess и прочие точечные файлы наружу не отдаём
    location ~ /\. {
        deny all;
    }

    location / {
        add_header Cache-Control "public, max-age=0, must-revalidate" always;
        add_header X-Content-Type-Options "nosniff" always;
        add_header Referrer-Policy "strict-origin-when-cross-origin" always;
        try_files $uri $uri/ =404;
    }
}

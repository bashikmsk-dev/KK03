# Нормализация переводов строк: в репозитории всегда LF, а в рабочей копии
# Git подставит привычный для системы вариант — на Windows CRLF.
* text=auto

*.html  text
*.css   text
*.js    text
*.json  text
*.md    text
*.yml   text
*.svg   text
*.py    text

# Бинарные файлы Git не должен трогать
*.png   binary
*.jpg   binary
*.jpeg  binary
*.webp  binary
*.woff  binary
*.woff2 binary
*.ttf   binary
*.otf   binary
*.pdf   binary
*.mp4   binary
